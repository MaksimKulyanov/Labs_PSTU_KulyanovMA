{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Собрать и запустить текущую программу C++",
      "type": "shell",
      "command": "g++ -std=c++17 -Wall -Wextra -pedantic \"${file}\" -o \"/tmp/${fileBasenameNoExtension}\" && \"/tmp/${fileBasenameNoExtension}\"",
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
